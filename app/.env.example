# Porta da Losambo (consola + API pública)
PORT=4000

# PostgreSQL (docker compose up -d postgres)
DATABASE_URL=postgres://losambo:losambo@localhost:5433/losambo
# true = SSL (Supabase e outras bases geridas); false = PostgreSQL local; vazio = segue o sslmode do URL
DATABASE_SSL=
DATABASE_POOL_MAX=10

# WAHA — motor WhatsApp. Nunca expor à internet.
WAHA_URL=http://localhost:3000
# Chave ADMIN do WAHA. Só serve para criar/apagar sessões e gerir chaves das contas.
# WAHA_USE_CUSTOM_API_KEY=true  → usa a chave fixa em WAHA_API_KEY (tem de ser a mesma do container).
# WAHA_USE_CUSTOM_API_KEY=false → (ou WAHA_API_KEY vazio) usa a chave que o WAHA gera em cada arranque,
#                                lida de `docker logs $WAHA_CONTAINER`; relida sozinha se o WAHA reiniciar.
WAHA_USE_CUSTOM_API_KEY=false
WAHA_API_KEY=
WAHA_CONTAINER=waha
# Segredo usado para cifrar as chaves WAHA das contas na base de dados. Gere um valor aleatório.
LOSAMBO_SECRET_KEY=
# O motor (GOWS recomendado: sem browser, menos RAM) define-se no próprio WAHA:
# WHATSAPP_DEFAULT_ENGINE=GOWS no container do WAHA.

# Endereço onde o WAHA (dentro do Docker) chama a Losambo.
# host.docker.internal funciona no Docker Desktop (Windows/macOS).
WAHA_WEBHOOK_BASE=http://host.docker.internal:4000
# Segredo no caminho do webhook interno (/hooks/waha/<token>). Gere um valor aleatório.
WAHA_WEBHOOK_TOKEN=

# Entrar com Google — crie um "OAuth client ID" (Aplicação Web) em
# https://console.cloud.google.com/apis/credentials e registe o URI de redirecionamento abaixo.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/auth/google/callback

# Entrar com WhatsApp: sessão WAHA (número Losambo) que envia os códigos.
# Vazio = usa o primeiro número Losambo ligado (os "por omissão" primeiro).
WHATSAPP_AUTH_SESSION=

# URL pública da API (mostrada na documentação)
PUBLIC_API_URL=http://localhost:4000/v1

# Desenvolvimento: permite webhooks/ficheiros em localhost e redes privadas (NUNCA em produção)
ALLOW_PRIVATE_URLS=false
# Atrás de um proxy (Coolify/Traefik): 1 = confia no primeiro proxy para o IP do cliente
TRUST_PROXY=0

# Duração da sessão na consola (dias)
SESSION_DAYS=14
# OTP
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5

# Tipos de conta (planos). Limites: número, ou "ilimitado".
PLAN_FREE_LABEL=Grátis
PLAN_FREE_MONTHLY_MESSAGES=100
PLAN_FREE_ALLOW_OWN_NUMBERS=false
PLAN_FREE_MAX_OWN_NUMBERS=0
PLAN_STARTUP_LABEL=Startup
PLAN_STARTUP_MONTHLY_MESSAGES=5000
PLAN_STARTUP_ALLOW_OWN_NUMBERS=false
PLAN_STARTUP_MAX_OWN_NUMBERS=0
PLAN_BUSINESS_LABEL=Negócio
PLAN_BUSINESS_MONTHLY_MESSAGES=ilimitado
PLAN_BUSINESS_ALLOW_OWN_NUMBERS=true
PLAN_BUSINESS_MAX_OWN_NUMBERS=ilimitado
PLAN_INTERNAL_LABEL=Interno

# Entrar com WhatsApp: limites dos códigos
WHATSAPP_AUTH_RESEND_SECONDS=60
WHATSAPP_AUTH_MAX_PER_PHONE_HOUR=5
WHATSAPP_AUTH_MAX_PER_IP_HOUR=20
